{
  "name": "statsig-audit",
  "version": "0.1.0",
  "private": true,
  "description": "A read-only hygiene audit for your Statsig project: stale gates, forgotten rollouts, broken targeting, experiments past their plan, metric trust. Markdown or JSON report, CI friendly. Unofficial.",
  "type": "module",
  "bin": {
    "statsig-audit": "bin/statsig-audit.js"
  },
  "files": [
    "bin/",
    "src/"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "golden": "node scripts/update-golden.mjs",
    "docs": "node scripts/build-docs.mjs",
    "check:generated": "node scripts/update-golden.mjs --check && node scripts/build-docs.mjs --check"
  },
  "author": {
    "name": "Arda Asaroglu",
    "url": "https://github.com/ardaasaroglu"
  },
  "license": "MIT",
  "homepage": "https://github.com/ardaasaroglu/statsig-audit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardaasaroglu/statsig-audit.git"
  },
  "bugs": {
    "url": "https://github.com/ardaasaroglu/statsig-audit/issues"
  },
  "keywords": [
    "statsig",
    "feature-flags",
    "feature-gates",
    "experiments",
    "ab-testing",
    "audit",
    "hygiene",
    "stale-flags",
    "cli",
    "github-action"
  ]
}
